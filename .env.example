# GobbleCube Core Intelligence — environment placeholder.
# Copy to .env (gitignored) and fill in, then load with:  set -a; source .env; set +a
# or export the lines directly in your shell before `make serve`.

# --- LLM transport (core/gateway) -------------------------------------------
# Bifrost is a model-agnostic gateway exposed as an OpenAI-compatible unified
# API (POST {base_url}/chat/completions) — NOT an Anthropic-compatible proxy.
# Model ids without a "/" (e.g. "claude-sonnet-5") get provider-prefixed
# automatically per GC_BIFROST_PROVIDER; a model id already containing "/"
# (e.g. "openai/gpt-5") passes through untouched — the model-agnostic knob.
GC_BIFROST_BASE_URL=http://REPLACE_WITH_BIFROST_HOST:8080/v1
GC_BIFROST_API_KEY=REPLACE_WITH_BIFROST_VIRTUAL_KEY
GC_BIFROST_PROVIDER=anthropic
GC_LLM_TRANSPORT=bifrost

# --- Direct Anthropic (alternative to Bifrost) ------------------------------
# Uncomment to bypass Bifrost and call api.anthropic.com (or another
# Anthropic-compatible endpoint) directly via the SDK transport instead.
# ANTHROPIC_API_KEY=sk-ant-REPLACE_WITH_KEY
# GC_LLM_BASE_URL=https://REPLACE_WITH_ANTHROPIC_COMPATIBLE_HOST  # rare; not Bifrost
# GC_LLM_TRANSPORT=sdk

# Transport selection precedence: GC_LLM_TRANSPORT (if set) always wins;
# otherwise: bifrost (if GC_BIFROST_BASE_URL is set) -> sdk (if
# ANTHROPIC_API_KEY is set) -> cli (authenticated `claude` CLI, dev default).

# --- Direct Moonshot / Kimi K2.5 (alternative provider, no Bifrost) ---------
# Moonshot exposes an OpenAI-compatible API too, so BifrostTransport works
# against it directly — just point GC_BIFROST_BASE_URL at Moonshot instead of
# a Bifrost host and set the provider prefix accordingly (or leave model ids
# already-qualified, e.g. "moonshot/kimi-k2.5", and unset GC_BIFROST_PROVIDER).
# GC_BIFROST_BASE_URL=https://api.moonshot.ai/v1
# GC_BIFROST_API_KEY=REPLACE_WITH_MOONSHOT_API_KEY
# GC_BIFROST_PROVIDER=moonshot
# GC_LLM_TRANSPORT=bifrost

# --- Model tiers (core/gateway/model_router.py) -----------------------------
# resolve_model(call_class, effort=None) is the one place a model id gets
# chosen — nothing else should hardcode one. Three tiers, each provider-
# agnostic (any tier can point at a Bifrost-routed id, e.g. Kimi K2.5).
# Defaults below match the current Claude lineup; uncomment only to override.
# GC_MODEL_LIGHT=claude-haiku-4-5-20251001      # default tier for call_class="classify"
# GC_MODEL_STANDARD=claude-sonnet-5             # default tier for call_class="plan"
# GC_MODEL_HEAVY=claude-opus-4-8                # escalation only (effort="heavy")
#
# Example: route the heavy tier to Kimi K2.5 via Bifrost/Moonshot instead:
# GC_MODEL_HEAVY=moonshot/kimi-k2.5
#
# Per-call-class override — wins over tier AND effort entirely, scoped to
# that one call_class:
# GC_MODEL_OVERRIDE_CLASSIFY=claude-haiku-4-5-20251001
# GC_MODEL_OVERRIDE_PLAN=claude-sonnet-5

# --- Database (core/db) ------------------------------------------------------
# Defaults target the local compose Postgres (deploy/docker-compose.yml);
# uncomment only to override.
# GC_DATABASE_URL=postgresql+psycopg://gc_app:gc_app@localhost:5433/gc_intel
# GC_ADMIN_DATABASE_URL=postgresql+psycopg://gc_intel:gc_intel@localhost:5433/gc_intel
